// Independently authored COD2 CO-OP native SP UI. Developed by Heperkoo.
// Exactly ONE menuDef: the installed SP registry has a verified 64-menu limit.
// Tabs share this menu and use native dvarTest/showDvar visibility.
{
    menuDef
    {
        name coop_main
        rect 0 0 640 480
        fullscreen 0
        visible 0
        popup
        focusColor .98 .827 .58 1
        onOpen { setdvar coop_page "main"; setfocus coop_host_button; }
        onESC { close coop_main; open main_text; }
        itemDef
        {
            name coop_panel
            style 1
            rect -107 0 854 480
            backcolor .10 .12 .10 .98
            visible 1
            decoration
