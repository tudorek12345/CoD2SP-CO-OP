# Keep only independently authored source, tests, UI, build tools and README images.
/*
!/.gitignore
!/CMakeLists.txt
!/README.md
!/src/
!/launcher/
!/tests/
!/assets/
!/tools/
!/.github/
!/research/

/research/*
!/research/findings.json

/analysis/
/docs/
/build/
/dist/
/runtime/
/.vscode/
/tools/*
!/tools/build.ps1
!/tools/package.ps1
!/tools/Stage-NativeUi.ps1
!/tools/stage-native-ui.py
!/tools/Launch-SecondInstance.ps1
!/tools/verify-runtime.ps1
!/tools/diagnostics/
/tools/diagnostics/*
!/tools/diagnostics/CMakeLists.txt
!/tools/diagnostics/process_stacks.cpp
/.github/*
!/.github/images/
/.github/images/*
!/.github/images/main-menu.png

**/.git/
**/__pycache__/
*.pyc
*.user
*.pdb
*.obj
*.lib
*.dll
*.exe
*.iwd
*.d3dbsp
*.svg
*.log
*.dmp
